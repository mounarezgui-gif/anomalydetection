# Copie ce fichier en .env et remplis les vraies valeurs.
# Ne JAMAIS pousser le fichier .env réel sur GitHub.

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mydb?retryWrites=true&w=majority
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URL du frontend déployé, pour autoriser le CORS
FRONTEND_URL=https://ton-frontend.vercel.app
